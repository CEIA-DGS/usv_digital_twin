<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>dt_viz</name>
  <version>1.0.0</version>

  <description>
    Interface gráfica do Digital Twin para visualização do USV,
    alvos AIS, derrota planejada e alertas de colisão.
  </description>

  <maintainer email="seu-email@dominio.com">
    Equipe CEIA-DGS
  </maintainer>

  <license>Proprietary</license>

  <!-- Sistema de build. -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Dependências ROS 2. -->
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>dt_msgs</depend>

  <!-- Dependências da interface gráfica Qt. -->
  <build_depend>qtbase5-dev</build_depend>
  <exec_depend>libqt5widgets5</exec_depend>

  <!-- Dependências previstas para integrações futuras. -->
  <!--
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>